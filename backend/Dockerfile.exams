FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    EXAM_STORAGE_BOUNDARY=true

WORKDIR /app

# Slim, exam-API-only dependency set — deliberately NOT requirements.txt.
# The exam API never imports spaCy/sentence-transformers/FAISS/torch (see
# app/exam_main.py), so it does not need to ship them. The lock is generated from
# requirements-exams.txt (see docs/exams-staging-deployment.md) and every package
# is verified against its hash.
COPY requirements-exams.lock ./requirements-exams.lock
RUN pip install --no-cache-dir --require-hashes -r requirements-exams.lock

COPY app ./app

RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 7862

# /health/live never touches Firestore, so the probe does not spend free-tier reads.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health/live' % os.environ.get('PORT', '7862'), timeout=4)" || exit 1

CMD ["sh", "-c", "uvicorn app.exam_main:app --host 0.0.0.0 --port ${PORT:-7862}"]
