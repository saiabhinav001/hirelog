# ──────────────────────────────────────────────────────────────
# Backend Environment Variables (.env)
# ──────────────────────────────────────────────────────────────

# Environment: "development" | "production"
ENV=development

# ── Firebase ─────────────────────────────────────────────────
# Option A (Local dev): Path to the service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json

# Option B (Production host): Full JSON string of the service account key
# Generate with:  cat serviceAccountKey.json | python -c "import sys,json; print(json.dumps(json.load(sys.stdin)))"
# Paste the single-line JSON output as the value (no additional quotes)
# FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=your-firebase-project-id

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
# Local dev:    http://localhost:3000,http://localhost:3001,http://localhost:3002
# Production:   https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── FAISS (production only — persistent storage) ─────────
# Leave unset for local dev (defaults to backend/data/faiss/)
# For Hugging Face Spaces Docker, keep defaults unless mounting persistent storage.
# FAISS_DIR=data/faiss
# FAISS_INDEX_PATH=/data/faiss/index.faiss
# FAISS_MAPPING_PATH=/data/faiss/mapping.json

# ── Search / Dashboard Performance ────────────────────────────
MAX_SEARCH_RESULTS=20
DASHBOARD_SAMPLE_LIMIT=500
SEARCH_KEYWORD_SCAN_LIMIT=400
SEARCH_RATE_LIMIT_PER_MINUTE=120
SEARCH_SEMANTIC_MAX_CONCURRENCY=4
SEARCH_SEMANTIC_SLOT_WAIT_SECONDS=0.12
SEARCH_SEMANTIC_FAILURE_WINDOW_SECONDS=60
SEARCH_SEMANTIC_FAILURE_THRESHOLD=8
SEARCH_SEMANTIC_COOLDOWN_SECONDS=45
SEARCH_ENABLE_WARMUP=true
SEARCH_WARMUP_QUERIES=dsa interview questions,system design round,dbms sql joins,os process thread
SEARCH_ENGINE=faiss
TYPESENSE_ENABLED=false
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=interview_experiences
SEARCH_VECTOR_ALPHA=0.72
SEARCH_RRF_K=60
SEARCH_RRF_VECTOR_WEIGHT=0.7
SEARCH_RRF_LEXICAL_WEIGHT=0.3
SEARCH_INDEX_WORKERS=2
SEARCH_INDEX_QUEUE_MAX=2000
SEARCH_INDEX_WORKER_MODE=embedded
SEARCH_INDEX_QUEUE_BACKEND=memory
SEARCH_INDEX_FIRESTORE_COLLECTION=search_index_tasks
SEARCH_INDEX_MAX_ATTEMPTS=5
SEARCH_INDEX_LEASE_SECONDS=120
SEARCH_INDEX_POLL_INTERVAL_SECONDS=0.6
SEARCH_INDEX_FIRESTORE_CLAIM_BATCH=10
SEARCH_INDEX_DELETE_DONE_TASKS=true
SEARCH_INDEX_FRESHNESS_WARN_SECONDS=900
# SEARCH_REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL_SECONDS=180
SEARCH_RERANK_ENABLED=true
SEARCH_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SEARCH_RERANK_TOP_K=30
SEARCH_RERANK_WEIGHT=0.3
SEARCH_LONG_LATENCY_MS=1200
SEARCH_ANALYTICS_TOP_QUERIES=20
DASHBOARD_RATE_LIMIT_PER_MINUTE=90
MUTATION_RATE_LIMIT_PER_MINUTE=80

# ── Role Governance ────────────────────────────────────────────
# Comma-separated emails that should always have placement_cell role.
# Example: PLACEMENT_CELL_EMAILS=pcell@college.edu,placements@college.edu
PLACEMENT_CELL_EMAILS=

# ── Exams module (feature-flagged, off by default) ────────────
# See docs/adr/0008-exam-domain-state-machine.md
EXAMS_ENABLED=false
# Comma-separated emails granted exam faculty authority (server config only —
# never the legacy user role). Example: EXAM_FACULTY_EMAILS=prof@college.edu
EXAM_FACULTY_EMAILS=
EXAM_DEFAULT_WARNING_THRESHOLD=3
EXAM_DEFAULT_LATE_ADMISSION_GRACE_SECONDS=120
EXAM_FINALIZATION_BATCH_SIZE=50
EXAM_OUTBOX_LEASE_SECONDS=60
EXAM_OUTBOX_MAX_ATTEMPTS=5

# ── Rollback lever (Prompt 11, docs/adr/0016) ─────────────────────────────
# Blocks only NEW admissions, leaving already-admitted/in-progress attempts
# unaffected. Use this instead of EXAMS_ENABLED when rolling back while exams
# are in progress. Per-run pausing still uses the faculty "pause run" command.
EXAM_NEW_ADMISSIONS_PAUSED=false

# ── Institution identity / roster / OTP login (Prompt 2, docs/adr/0010) ──
# Set to a stable shared secret in any multi-instance/production deployment —
# unset uses a random per-process secret (dev-only; OTPs won't verify across
# restarts/instances until this is set).
# EXAM_OTP_HMAC_SECRET=
EXAM_OTP_TTL_SECONDS=300
EXAM_OTP_MAX_ATTEMPTS=5
EXAM_STAFF_REAUTH_MAX_AGE_SECONDS=900

# ── KT ingestion / generation providers (Prompt 5, docs/adr/0009) ─────
# Unset by default: uploads use the fail-closed NullMalwareScanner (never
# "clean") and generation uses the DeterministicFakeProvider (dev/test only).
# EXAM_MALWARE_SCANNER_ENDPOINT=
# EXAM_GENERATION_PROVIDER_BASE_URL=
# EXAM_GENERATION_PROVIDER_API_KEY=

# ── Independent item review (Backend model prompt B, docs/adr/0009) ───
# A separate provider/endpoint from generation above. Unset by default:
# falls back to DeterministicFakeReviewProvider (dev/test only).
# EXAM_REVIEW_PROVIDER_BASE_URL=
# EXAM_REVIEW_PROVIDER_API_KEY=

# ── Coding judge (Prompt 6, docs/adr/0011) ────────────────────────────
# Unset by default: falls back to a deterministic fake judge (test/dev only,
# never executes submitted code). A real Judge0-compatible instance requires
# separately provisioned hardened isolated compute — this config alone does
# not create or validate that environment (see ADR for requirements).
# EXAM_JUDGE_PROVIDER_BASE_URL=
# EXAM_JUDGE_PROVIDER_API_KEY=

# ── Live control WebSocket (Prompt 7, docs/adr/0012) ──────────────────
# Single-use admission ticket TTL — a client mints a fresh one per connect/
# reconnect attempt rather than reusing one.
EXAM_LIVE_TICKET_TTL_SECONDS=60

# ── Proctoring evidence (Prompt 8, docs/adr/0013) ─────────────────────
# grace/cooldown tune observation correlation; the block THRESHOLD itself is
# per-run policy (ExamPolicy.warning_threshold), never a global setting.
EXAM_PROCTORING_GRACE_SECONDS=2.0
EXAM_PROCTORING_COOLDOWN_SECONDS=5.0
EXAM_PROCTORING_STALE_INCIDENT_SECONDS=120.0
EXAM_EVIDENCE_UPLOAD_TICKET_TTL_SECONDS=120
EXAM_EVIDENCE_VIEW_TICKET_TTL_SECONDS=60
EXAM_EVIDENCE_RETENTION_DAYS=90
# Unset by default: falls back to InMemoryEvidenceStorage (dev/test only —
# content does not survive a process restart). Set to a provisioned Firebase
# Storage bucket name for real, persistent evidence storage.
# EXAM_EVIDENCE_STORAGE_BUCKET=

# ── Gradebook / similarity / export (Prompt 9, docs/adr/0014) ────────
# Export downloads reuse EXAM_EVIDENCE_STORAGE_BUCKET (different key prefix),
# no separate bucket setting. Unset JPlag path falls back to a deterministic
# fake similarity provider (test/dev only, never performs real comparison).
EXAM_EXPORT_DOWNLOAD_TICKET_TTL_SECONDS=300
# EXAM_JPLAG_JAR_PATH=
EXAM_JPLAG_JAVA_EXECUTABLE=java

